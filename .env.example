AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
DEFAULT_TOP_K=4
DEFAULT_MIN_SCORE=0.30
